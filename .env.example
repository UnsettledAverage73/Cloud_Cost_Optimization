# CloudPulse Sovereign FinOps Configuration Template
# LLM Backend (Groq Cloud API Key)
GROQ_API_KEY=your_groq_api_key_here

# AWS Environment
AWS_DEFAULT_REGION=us-east-1
CLOUDPULSE_ENVIRONMENT=production

# Render Database (TimescaleDB)
DATABASE_URL=postgresql://user:password@host/dbname

# Multi-Channel FinOps Notifications (Slack & Microsoft Teams)
SLACK_WEBHOOK_URL=your_slack_webhook_url_here
TEAMS_WEBHOOK_URL=your_teams_webhook_url_here

# LangSmith Observability & Tracing
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=cloudpulse-jew-architect

# Jew System Architect (SemIf / Jev System-1 Decision Engine)
DECISION_MODEL_PROVIDER=semif # Options: 'semif' (open-source) or 'jev' (TypeSafe AI)
SEMIF_ENDPOINT=http://localhost:8001
SEMIF_MODEL=qwen3.5-4b-bf16
JEV_API_KEY=your_jev_api_key_if_using_typesafe_ai
