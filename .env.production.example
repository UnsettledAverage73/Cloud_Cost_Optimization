# =====================================================================
# 🌐 CLOUDPULSE PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# =====================================================================
# Copy this file to .env or inject these variables into your Kubernetes
# Secret / ConfigMap or AWS Secrets Manager.

# --- Core Server & SRE Settings ---
ENVIRONMENT=production
PORT=8000
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- Production Rate Limiting (Sliding Window) ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_MAX=120
RATE_LIMIT_HIGH_COMPUTE_MAX=40
RATE_LIMIT_WINDOW_SECONDS=60

# --- Autonomous AI Copilot & Groq LLM ---
GROQ_API_KEY=gsk_your_groq_production_api_key_here
GROQ_PRIMARY_MODEL=llama-3.3-70b-versatile
GROQ_FAST_MODEL=llama-3.1-8b-instant

# --- Telemetry & Persistent Datastore ---
# TimescaleDB / PostgreSQL production connection URI:
DATABASE_URL=postgresql://cloudpulse:your_secure_password@timescaledb.internal:5432/cloudpulse_telemetry
# In-memory Redis cache (optional, falls back to in-memory TTL query cache):
REDIS_URL=redis://redis.internal:6379/0

# --- CNCF OpenCost Kubernetes Telemetry ---
OPENCOST_URL=http://opencost.opencost.svc.cluster.local:9003
K8S_CLUSTER_NAME=eks-production-cluster
K8S_TELEMETRY_MODE=opencost

# --- Multi-Channel Alerting: Slack & Microsoft Teams ---
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T00/B00/YOUR_PRODUCTION_WEBHOOK
SLACK_BOT_TOKEN=xoxb-your-production-bot-token
SLACK_APP_TOKEN=xapp-your-production-app-token
SLACK_CHANNEL=#finops-alerts
TEAMS_WEBHOOK_URL=https://outlook.office.com/webhook/YOUR_TEAMS_WEBHOOK

# --- Currency & Regional Localization ---
DEFAULT_CURRENCY=USD
USD_TO_INR_RATE=84.00
AWS_DEFAULT_REGION=us-east-1
