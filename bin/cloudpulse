#!/usr/bin/env python3
import sys
import os
import glob

CURRENT_DIR = os.path.dirname(os.path.abspath(__file__))
ROOT_DIR = os.path.abspath(os.path.join(CURRENT_DIR, ".."))
VENV_PYTHON = os.path.join(ROOT_DIR, "venv", "bin", "python")

# If local venv exists and we're not currently running inside it, re-exec via venv python
if os.path.exists(VENV_PYTHON) and os.path.realpath(sys.executable) != os.path.realpath(VENV_PYTHON):
    os.execv(VENV_PYTHON, [VENV_PYTHON] + sys.argv)

BACKEND_DIR = os.path.join(ROOT_DIR, "backend")

# Fallback: ensure venv site-packages are on sys.path
for sp in glob.glob(os.path.join(ROOT_DIR, "venv", "lib", "python*", "site-packages")):
    if sp not in sys.path:
        sys.path.insert(0, sp)

for p in [BACKEND_DIR, ROOT_DIR]:
    if p not in sys.path:
        sys.path.insert(0, p)

from cli_main import main

if __name__ == "__main__":
    main()
